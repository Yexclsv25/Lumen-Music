<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- Everything glass looks through lives in here -->
    <com.yexclsv.localfiles.ui.BackdropLayout
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg">

        <com.yexclsv.localfiles.ui.AuroraView
            android:id="@+id/aurora"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <FrameLayout
            android:id="@+id/pages"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <include
                android:id="@+id/pageLibrary"
                layout="@layout/page_library"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <include
                android:id="@+id/pagePlaylists"
                layout="@layout/page_playlists"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <include
                android:id="@+id/pageSettings"
                layout="@layout/page_settings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />
        </FrameLayout>
    </com.yexclsv.localfiles.ui.BackdropLayout>

    <!-- Glass top bar -->
    <com.yexclsv.localfiles.ui.GlassLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:elevation="6dp"
        app:glass_cornerRadius="30dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_icon_btn"
                    android:contentDescription="Back"
                    android:padding="10dp"
                    android:src="@drawable/ic_back"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Library"
                    android:textColor="@color/text"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/countBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_input"
                    android:paddingStart="10dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp"
                    android:textColor="@color/text2"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/spacer"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <EditText
                    android:id="@+id/searchField"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input"
                    android:hint="Search songs, artists, albums"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:textColor="@color/text"
                    android:textColorHint="@color/text2"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/btnSearch"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_icon_btn"
                    android:contentDescription="Search"
                    android:padding="10dp"
                    android:src="@drawable/ic_search" />

                <ImageView
                    android:id="@+id/btnAdd"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_icon_btn"
                    android:contentDescription="Add"
                    android:padding="10dp"
                    android:src="@drawable/ic_add" />
            </LinearLayout>

            <HorizontalScrollView
                android:id="@+id/chipScroll"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/chipRow"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp" />
            </HorizontalScrollView>
        </LinearLayout>
    </com.yexclsv.localfiles.ui.GlassLayout>

    <!-- Glass mini player -->
    <com.yexclsv.localfiles.ui.GlassLayout
        android:id="@+id/miniPlayer"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:elevation="8dp"
        android:visibility="gone"
        app:glass_cornerRadius="32dp">

        <ImageView
            android:id="@+id/miniArt"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="9dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="68dp"
            android:layout_marginEnd="104dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/miniTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/miniArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/miniPlay"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="52dp"
            android:contentDescription="Play or pause"
            android:padding="11dp"
            android:src="@drawable/ic_pause" />

        <ImageView
            android:id="@+id/miniNext"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="8dp"
            android:contentDescription="Next"
            android:padding="12dp"
            android:src="@drawable/ic_next" />

        <View
            android:id="@+id/miniProgress"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_pill"
            android:scaleX="0" />
    </com.yexclsv.localfiles.ui.GlassLayout>

    <!-- Glass tab bar with liquid indicator -->
    <com.yexclsv.localfiles.ui.GlassTabBar
        android:id="@+id/tabBar"
        android:layout_width="300dp"
        android:layout_height="64dp"
        android:layout_gravity="bottom|center_horizontal"
        android:elevation="8dp"
        app:glass_cornerRadius="32dp" />

    <include
        android:id="@+id/player"
        layout="@layout/view_player"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Host for glass action sheets -->
    <FrameLayout
        android:id="@+id/sheetHost"
        android:elevation="40dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Intro / loading screen -->
    <FrameLayout
        android:id="@+id/intro"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:clickable="true"
        android:elevation="60dp"
        android:focusable="true">

        <com.yexclsv.localfiles.ui.AuroraView
            android:id="@+id/introAurora"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/introLogo"
                android:layout_width="116dp"
                android:layout_height="116dp"
                android:contentDescription="@null"
                android:src="@drawable/logo" />

            <TextView
                android:id="@+id/introTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Lumen"
                android:textColor="@color/text"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/introTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Your music. Your files."
                android:textColor="@color/text2"
                android:textSize="14sp" />

            <com.yexclsv.localfiles.ui.EqView
                android:id="@+id/introBars"
                android:layout_width="30dp"
                android:layout_height="26dp"
                android:layout_marginTop="34dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/introFoot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="44dp"
            android:text="made by yexclsv"
            android:textColor="@color/text2"
            android:textSize="12sp" />
    </FrameLayout>
</FrameLayout>
