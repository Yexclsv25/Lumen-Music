<?xml version="1.0" encoding="utf-8"?>
<com.yexclsv.localfiles.ui.DragDismissLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clickable="true"
    android:elevation="30dp"
    android:focusable="true"
    android:visibility="gone">

    <com.yexclsv.localfiles.ui.BackdropLayout
        android:id="@+id/ambientHost"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg">

        <ImageView
            android:id="@+id/ambient"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#8C09090D" />
    </com.yexclsv.localfiles.ui.BackdropLayout>

    <LinearLayout
        android:id="@+id/playerContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="64dp">

            <View
                android:layout_width="40dp"
                android:layout_height="5dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="8dp"
                android:alpha="0.35"
                android:background="@drawable/bg_pill" />

            <ImageView
                android:id="@+id/btnClose"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="16dp"
                android:background="@drawable/bg_icon_btn"
                android:contentDescription="Close"
                android:padding="10dp"
                android:src="@drawable/ic_chevron_down" />

            <TextView
                android:id="@+id/playerLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="12dp"
                android:text="NOW PLAYING"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnMore"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_icon_btn"
                android:contentDescription="More"
                android:padding="10dp"
                android:src="@drawable/ic_more" />
        </FrameLayout>

        <com.yexclsv.localfiles.ui.SquareFitLayout
            android:id="@+id/artHolder"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="30dp"
            android:paddingTop="14dp"
            android:paddingEnd="30dp"
            android:paddingBottom="14dp">

            <ImageView
                android:id="@+id/playerArt"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Album art"
                android:elevation="20dp"
                android:scaleType="centerCrop" />
        </com.yexclsv.localfiles.ui.SquareFitLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="30dp"
            android:paddingEnd="22dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/playerTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="marquee"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:singleLine="true"
                    android:textColor="@color/text"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/playerArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text2"
                    android:textSize="17sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnFav"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Favorite"
                android:padding="12dp"
                android:src="@drawable/ic_heart_outline" />
        </LinearLayout>

        <com.yexclsv.localfiles.ui.LiquidSeekBar
            android:id="@+id/seek"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="16dp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="30dp"
            android:paddingEnd="30dp">

            <TextView
                android:id="@+id/timeCur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:text="0:00"
                android:textColor="@color/text2"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/timeRemain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text="-0:00"
                android:textColor="@color/text2"
                android:textSize="12sp" />
        </FrameLayout>

        <com.yexclsv.localfiles.ui.GlassLayout
            android:id="@+id/controlsGlass"
            android:layout_width="300dp"
            android:layout_height="92dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="18dp"
            android:elevation="6dp"
            app:glass_cornerRadius="46dp">

            <ImageView
                android:id="@+id/btnPrev"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="18dp"
                android:contentDescription="Previous"
                android:padding="14dp"
                android:src="@drawable/ic_prev" />

            <ImageView
                android:id="@+id/btnPlay"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_circle"
                android:contentDescription="Play or pause"
                android:padding="20dp"
                android:src="@drawable/ic_pause"
                app:tint="#FF101014" />

            <ImageView
                android:id="@+id/btnNext"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="18dp"
                android:contentDescription="Next"
                android:padding="14dp"
                android:src="@drawable/ic_next" />
        </com.yexclsv.localfiles.ui.GlassLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <ImageView
                android:id="@+id/btnShuffle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="Shuffle"
                android:padding="16dp"
                android:src="@drawable/ic_shuffle" />

            <TextView
                android:id="@+id/btnSpeed"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="1x"
                android:textColor="#B3FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnSleep"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="Sleep timer"
                android:padding="16dp"
                android:src="@drawable/ic_timer" />

            <ImageView
                android:id="@+id/btnQueue"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="Up next"
                android:padding="16dp"
                android:src="@drawable/ic_queue_music" />

            <ImageView
                android:id="@+id/btnRepeat"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="Repeat"
                android:padding="16dp"
                android:src="@drawable/ic_repeat" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="12dp" />
    </LinearLayout>
</com.yexclsv.localfiles.ui.DragDismissLayout>
